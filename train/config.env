# The one source of the campaign pins and the shared names
# (TRN-EXEC-2). scripts/infra, scripts/train, and scripts/train-driver
# read this file. The bucket names come from corpus.md COR-BUCKETS-1.
#
# Each image pin is a dated tag, read on 2026-08-28. Confirm each pin
# before a campaign, per the specification conventions. Not every
# llama.cpp build publishes an image: b10665 has no tag on ghcr, and
# b10666 is the nearest published build (read 2026-08-28).
AXOLOTL_IMAGE=axolotlai/axolotl:main-20260827-py3.12-cu130-2.12.1
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:full-b10666
LLAMACPP_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:full-cuda-b10666
LLAMA_VERSION=b10666
BASE_MODEL=Qwen/Qwen3-0.6B-Base
CORPUS_BUCKET=stx-corpus
EVAL_BUCKET=stx-evalcorpus
CHECKPOINT_BUCKET=stx-checkpoints
ARTIFACTS_BUCKET=stx-artifacts
HEARTBEAT_PREFIX=runs
