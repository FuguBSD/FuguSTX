# train: drive a campaign step against the provisioned train instance.
#
# usage: train cpt
#        train merge-cpt
#        train sft-base | train sft-cpt
#        train gguf --name sft-base|sft-cpt
#        train score --name NAME
#        train promote --name NAME --run-id RUN
#
# Each remote verb copies the tracked repository files to the
# instance, and it runs the matching scripts/train-driver step there
# over SSH (TRN-EXEC-3). The operator network resets SSH, so CI runs
# these verbs, per the LEARNING entries. The instance address comes
# from the train stack output. STX_SSH_KEY_FILE names the campaign
# SSH key.
#
# The promote verb runs on the local host, and it needs no instance.
# The gguf verb uploads each artifact to the checkpoint bucket at
# once, so promote copies it from there to the artifacts bucket, and
# the dev scorecard hash gates the copy (TRN-EXEC-5).
#
# Like scripts/deps, core modules only, and v5.34.

use v5.34;
use warnings;
use experimental 'signatures';

use Digest::SHA    ();
use File::Basename qw(dirname);
use File::Spec     ();
use File::Temp     ();
use Getopt::Long   qw(GetOptionsFromArray);

my $USAGE = <<'EOF';
usage: train cpt
       train merge-cpt
       train sft-base | train sft-cpt
       train gguf --name sft-base|sft-cpt
       train score --name NAME
       train promote --name NAME --run-id RUN
EOF

my $ROOT     = dirname( dirname( File::Spec->rel2abs(__FILE__) ) );
my $ENDPOINT = 's3.fr-par.scw.cloud';

# _ip():
#	The instance address, from the train stack output. A fresh CI
#	runner holds no initialized backend, so the read inits first.
sub _ip ()
{
	system( 'tofu', "-chdir=$ROOT/infra/train", 'init', '-input=false' )
	    == 0
	    or die "train: tofu init failed for the train stack\n";
	my $pid = open my $fh, '-|',
	    'tofu', "-chdir=$ROOT/infra/train", 'output', '-raw', 'public_ip'
	    or die "train: run tofu: $!\n";
	my $ip = <$fh> // '';
	close $fh;
	chomp $ip;
	die "train: no train stack output; run make infra-up STACK=train\n"
	    if $? || $ip !~ /^[0-9a-f.:]+\z/;

	return $ip;
}

# _ssh_argv($ip):
#	The ssh argument list of the train instance. The keepalives
#	hold the connection through a long quiet remote step: the
#	runner NAT drops an idle stream (probed 2026-08-28, a broken
#	pipe after ten quiet minutes of dev scoring).
sub _ssh_argv ($ip)
{
	my @argv = (
		'ssh',
		'-o', 'BatchMode=yes',
		'-o', 'StrictHostKeyChecking=accept-new',
		'-o', 'ServerAliveInterval=30',
		'-o', 'ServerAliveCountMax=10',
	);
	push @argv, '-i', $ENV{STX_SSH_KEY_FILE} if $ENV{STX_SSH_KEY_FILE};

	return ( @argv, "root\@$ip" );
}

# _push($ip):
#	Copy the tracked repository files to /scratch/stx, through a
#	tar pipe: rsync is not part of the GPU OS image.
sub _push ($ip)
{
	my @ssh = _ssh_argv($ip);
	my $tar = "cd \Q$ROOT\E && git ls-files -z | tar --null -T - -czf -";
	my $out = "mkdir -p /scratch/stx && tar -C /scratch/stx -xzf -";
	system("$tar | @ssh \Q$out\E") == 0
	    or die "train: the repository push to $ip failed\n";
	say "train: the repository is on $ip:/scratch/stx";

	return;
}

# _remote($ip, $command):
#	One driver step on the instance, with the train environment and
#	the campaign pins of train/config.env.
sub _remote ( $ip, $command )
{
	my @ssh = _ssh_argv($ip);
	my $wrapped =
	    'cd /scratch/stx && set -a && . /root/stx-train.env && '
	    . ". train/config.env && set +a && $command";
	system( @ssh, $wrapped ) == 0
	    or die "train: the remote step failed: $command\n";

	return;
}

# _uv():
#	The uv install line of the score step. The instance image has
#	no uv; the score step needs the Python scorer.
sub _uv ()
{
	return 'export PATH=$HOME/.local/bin:$PATH; '
	    . 'command -v uv >/dev/null 2>&1 || '
	    . '{ curl -LsSf https://astral.sh/uv/install.sh | sh; }';
}

# _config():
#	Read train/config.env into %ENV. The stackless promote needs
#	the bucket names on the local host; a remote step reads the
#	file on the instance instead.
sub _config ()
{
	open my $fh, '<', "$ROOT/train/config.env"
	    or die "train: read $ROOT/train/config.env: $!\n";
	while ( my $line = <$fh> ) {
		chomp $line;
		next if $line =~ /^\s*(?:#|\z)/;
		my ( $key, $value ) = split /=/, $line, 2;
		$ENV{$key} = $value;
	}
	close $fh;

	return;
}

# _aws(@args):
#	One S3 client call against the Scaleway endpoint, on the local
#	host. The CI runner image provides the client, as in t1.yml.
sub _aws (@args)
{
	system( 'aws', '--endpoint-url', "https://$ENDPOINT", 's3', @args )
	    == 0
	    or die "train: the S3 call failed: @args\n";

	return;
}

# _promote($name, $run_id):
#	Promote one artifact, on the local host. The gguf verb put the
#	artifact in the checkpoint bucket, so the copy needs no
#	instance. The dev scorecard hash gates the copy: the promoted
#	artifact must be the scored artifact (TRN-EXEC-5).
sub _promote ( $name, $run_id )
{
	_config();
	my $dir  = File::Temp::tempdir( CLEANUP => 1 );
	my $gguf = "$dir/$name.gguf";
	my $card = "$dir/scorecard.json";
	_aws( 'cp',
		"s3://$ENV{CHECKPOINT_BUCKET}/$ENV{HEARTBEAT_PREFIX}/"
		    . "$run_id/gguf/$name.gguf",
		$gguf );
	_aws( 'cp',
		"s3://$ENV{ARTIFACTS_BUCKET}/runs/$run_id/"
		    . "scorecard-dev-$name.json",
		$card );

	open my $fh, '<', $card or die "train: read $card: $!\n";
	my $json = do { local $/ = undef; <$fh> };
	close $fh;
	my ($expected) = $json =~ /"model_hash":\s*"([0-9a-f]{64})"/
	    or die "train: the scorecard holds no model_hash\n";

	my $hash = Digest::SHA->new(256)->addfile($gguf)->hexdigest;
	say "promote: sha256 $hash  $name.gguf";
	die "train: the artifact hash does not match the scorecard\n"
	    unless $hash eq $expected;

	my $key = "runs/$run_id/stx-$name.gguf";
	_aws( 'cp', $gguf, "s3://$ENV{ARTIFACTS_BUCKET}/$key" );
	say "promote: s3://$ENV{ARTIFACTS_BUCKET}/$key";

	return;
}

# main(@argv):
#	The verb dispatcher.
sub main (@argv)
{
	my $verb = shift @argv // die $USAGE;
	my ( $name, $run_id );
	GetOptionsFromArray(
		\@argv,
		'name=s'   => \$name,
		'run-id=s' => \$run_id,
	) or die $USAGE;
	die $USAGE if defined $run_id && $verb ne 'promote';

	if ( $verb eq 'promote' ) {
		die $USAGE unless defined $name && defined $run_id;
		_promote( $name, $run_id );
		return 0;
	}

	my $ip = _ip();
	_push($ip);

	if ( $verb eq 'cpt' ) {
		_remote( $ip,
			      'scripts/train-driver sync-corpus && '
			    . 'scripts/train-driver train --config train/cpt.yml'
		);
		return 0;
	}
	if ( $verb eq 'merge-cpt' ) {
		_remote( $ip,
			      'scripts/train-driver merge --config train/cpt.yml '
			    . '--lora /scratch/outputs/cpt '
			    . '--output /scratch/outputs/cpt-merged' );
		return 0;
	}
	if ( $verb eq 'sft-base' || $verb eq 'sft-cpt' ) {
		_remote( $ip,
			      'scripts/train-driver sync-corpus && '
			    . "scripts/train-driver train --config train/$verb.yml"
		);
		return 0;
	}
	if ( $verb eq 'gguf' ) {
		die $USAGE unless defined $name;
		_remote( $ip,
			      "scripts/train-driver merge --config train/$name.yml "
			    . "--lora /scratch/outputs/$name "
			    . "--output /scratch/outputs/$name-merged && "
			    . 'mkdir -p /scratch/gguf && '
			    . 'scripts/train-driver gguf '
			    . "--input /scratch/outputs/$name-merged "
			    . "--output /scratch/gguf/$name.gguf" );
		return 0;
	}
	if ( $verb eq 'score' ) {
		die $USAGE unless defined $name;

		# The dev split only: the synced training.jsonl holds it,
		# and the eval lane stays in the gated CPU sweep of tier
		# T1. The server runs on the GPU, because the instance
		# bills per minute; decision T2 binds the shipped engine
		# and the tier T1 gate, and both stay on the CPU. The
		# scorecard records the device.
		_remote( $ip,
			      "scripts/train-driver serve --model /scratch/gguf/$name.gguf && "
			    . _uv() . ' && '
			    . 'mkdir -p /scratch/scorecards && '
			    . 'uv run --locked python -m stx_corpus.t1 '
			    . '--split dev '
			    . '--records /scratch/corpus/training.jsonl '
			    . q{--stx 'bin/stx label --server http://127.0.0.1:8080' }
			    . "--model /scratch/gguf/$name.gguf "
			    . "--label $name --device gpu "
			    . '--run-id "$STX_RUN_ID" '
			    . '--llama-version "$LLAMA_VERSION" '
			    . "--out /scratch/scorecards/$name-dev.json "
			    . '--upload; '
			    . 'status=$?; scripts/train-driver serve-stop; '
			    . 'exit $status' );
		return 0;
	}
	die $USAGE;
}

exit main(@ARGV) unless caller;
